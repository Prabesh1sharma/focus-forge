{
  "manifest_version": 3,
  "name": "FocusForge Distraction Blocker",
  "version": "1.0.0",
  "description": "Enforce distraction blocking during FocusForge focus sessions.",
  "key": "",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusForge Blocker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "blocked.html",
        "options.html",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
